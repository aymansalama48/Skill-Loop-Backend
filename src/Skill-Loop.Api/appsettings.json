{
  // ==========================================
  // 1. إعدادات التسجيل الافتراضية الخاصة بـ .NET Framework
  // ==========================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // السماح باستقبال الطلبات من أي Host (مناسب لبيئة التطوير Local)
  "AllowedHosts": "*",

  // ==========================================
  // 2. نص الاتصال بقاعدة البيانات (SQL Server Connection String)
  // ==========================================
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=AYMAN\\MSSQLSERVER01;Database=Skill-Loop;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True;Packet Size=4096;Command Timeout=0"
  },

  // ==========================================
  // 3. إعدادات الـ CORS (عناوين الـ Frontend المسموح لها بالاتصال)
  // ==========================================
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5500"
    ]
  },

  // ==========================================
  // 4. إعدادات مكتبة Serilog للتسجيل الهيكلي (Structured Logging)
  // ==========================================
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],

    "MinimumLevel": {
      "Default": "Information",

      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },

      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  // ==========================================
  // 5. إعدادات الـ JWT (التوثيق)
  // ==========================================
  "Jwt": {
    "Key": "kjh4df467gdshk-fjg69fdk6745385-fg7t5fgi-f7t1ifg674-d5hni7th6iet-76cbv4fgh-ds,jkf7",
    "Issuer": "https://localhost:7271",
    "Audience": "https://localhost:7271",
    "ExpiryMinutes": 60
  },

  // ==========================================
  // 6. إعدادات البريد الإلكتروني (SMTP)
  // ==========================================
  "MailSettings": {
    "SenderEmail": "Skill-Loop@yahoo.com",
    "SenderName": "Skill-Loop",
    "ClinicName": "Skill-Loop",
    "Host": "smtp.mail.yahoo.com",
    "Port": 587,
    "Username": "Skill-Loop",
    "Password": "*********",
    "EnableSsl": true
  },

  // ==========================================
  // 7. إعدادات تخزين الملفات (File Storage)
  // ==========================================
  "FileStorage": {
    "Provider": "Local",
    "RootFolder": "UploadedFiles",
    "CreateIfNotExists": true,
    "MaxFileSizeInMB": 10,
    "GenerateUniqueFileName": true,
    "PreserveOriginalFileName": false,
    "OverwriteExistingFiles": false,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".svg",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".zip",
      ".rar",
      ".7z"
    ]
  },

  // ==========================================
  // 8. إعدادات الرابط الأساسي للتطبيق (Base URL)
  // ==========================================
  "BaseUrl": {
    "Backend": "https://localhost:7271",
    "Frontend": "https://localhost:5173"
  },

  // ==========================================
  // 9. إعدادات رمز التحقق (OTP Settings)
  // ==========================================
  "OtpSettings": {
    "CodeLength": 6,
    "Expiry": "00:05:00",
    "ResendCooldown": "00:01:00",
    "MaxAttempts": 3,
    "HashingSecret": "YourSuper46854SecretOtpHashingSec56645retKeyHere_Minimum465645132Characters!"
  },

  // ==========================================
  // 10. إعدادات التسجيل بواسطة جوجل (Google Auth)
  // ==========================================
  "GoogleAuth": {
    "ClientId": "**********"
  },

  // ==========================================
