### phase: P14   auth: userToken   expect: [200]

GET /api/v1/Chat/conversations/{{conversationId}}/messages?pageNumber=1&pageSize=20
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
### [137] S223  Send a message via REST
