################################################################################################
### [171] S290  Delete the test session
### phase: P18   auth: instructorToken   expect: [200, 204, 409]
### note: Run after S207. If the booking was cancelled, deletion may still be blocked by the S206 review - that is a deliberate referential-integrity check.

DELETE /api/v1/Sessions/{{sessionId}}
Accept: application/json
Authorization: Bearer {{instructorToken}}


################################################################################################
### [172] S290b  Delete the test lesson
### phase: P18   auth: adminToken   expect: [200, 204, 409]
### note: Must run BEFORE deleting the section, otherwise the section delete cascades. Deleting a lesson the student has completed may be rejected, so a 409 is a valid outcome here.

DELETE /api/v1/courses/{{courseId}}/sections/{{sectionId}}/lessons/{{lessonId}}
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [173] S290c  Delete the test section
### phase: P18   auth: adminToken   expect: [200, 204, 409]
### note: Uses section2Id, the section created in S102 and never given a lesson, so this is the cleanest section to remove. Deleting the section that still holds lessonId usually fails while the lesson exists.

DELETE /api/v1/courses/{{courseId}}/sections/{{section2Id}}
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [174] S291  Delete a throwaway category
### phase: P18   auth: adminToken   expect: [200, 204, 409]
### note: The proper place for this step, since S099 had to be skipped. Delete S124's course first if you need a clean 204.

DELETE /api/v1/Categories/{{categoryId}}
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [175] S292  Delete the test course
### phase: P18   auth: adminToken   expect: [200, 204, 409]
### note: Cancels out the enrollments created in phase P9. Deleting an archived course (S123) may be the only allowed route.

DELETE /api/v1/Courses/{{courseId}}
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [176] S293  Remove the Instructor role from the test account
### phase: P18   auth: adminToken   expect: [200, 204]
### note: Completes the S052/S054 round trip in a consistent end state.

DELETE /api/v1/Users/{{student2UserId}}/roles/Instructor
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [177] S294  Deactivate the test student accounts
### phase: P18   auth: adminToken   expect: [200, 204]
### note: Prefer deactivation over deletion here - there is no delete-user endpoint.

PATCH /api/v1/Users/{{student1UserId}}/deactivate
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [178] S295  Deactivating a user blocks login (negative check)
### phase: P18   auth: none   expect: [400]
### note: Deliberate failure, closes the deactivate/activate loop from S055.

POST /api/v1/Auth/user/login
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "password": "Password@123"
}

################################################################################################
### [179] S296  Reactivate the test student accounts
### phase: P18   auth: adminToken   expect: [200, 204]

PATCH /api/v1/Users/{{student1UserId}}/activate
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [180] S297  Log out the admin session
### phase: P18   auth: adminToken   expect: [200, 204]
### note: Last step. Afterwards only the 60-minute access token remains valid, and it expires on its own.

POST /api/v1/Auth/logout
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "refreshToken": "{{adminRefreshToken}}"
}

