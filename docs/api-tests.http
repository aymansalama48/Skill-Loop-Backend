### phase: P12   auth: userToken   expect: [200]
### note: A second purchase path alongside /credit-purchases; confirm both behave the same.

POST /api/v1/Wallets/buy-credits
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "amount": 50,
  "promoCode": null
}

################################################################################################
### [124] S189  Deactivate the promo code
### phase: P12   auth: adminToken   expect: [200, 204]

POST /api/v1/promo-codes/{{promoCodeId}}/deactivate
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [125] S190  A deactivated code no longer validates (negative check)
### phase: P12   auth: none   expect: [200]
### note: The endpoint still returns 200 with an invalid flag rather than a 4xx.

GET /api/v1/promo-codes/WELCOME10/validate
Accept: application/json


################################################################################################
### [126] S200  Book the published session
### phase: P13   auth: userToken   expect: [200, 204]
### note: Requires S161 to have published the session, and enough wallet credits. Fails with 409 if already booked, or with an insufficient-credits error otherwise.

POST /api/v1/Bookings
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "sessionId": "{{sessionId}}"
}

> {% client.global.set("bookingId", pm.response.json().data.id); %}

################################################################################################
### [127] S201  List my bookings
### phase: P13   auth: userToken   expect: [200]

GET /api/v1/Bookings/me?pageNumber=1&pageSize=10&upcomingOnly=True
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
### [128] S202  Get the booking by id
### phase: P13   auth: userToken   expect: [200]

GET /api/v1/Bookings/{{bookingId}}
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
### [129] S203  Instructor lists bookings for their session
### phase: P13   auth: instructorToken   expect: [200]

GET /api/v1/sessions/{{sessionId}}/bookings?pageNumber=1&pageSize=10&status=Pending
Accept: application/json
Authorization: Bearer {{instructorToken}}


################################################################################################
### [130] S204  Instructor confirms the booking
### phase: P13   auth: instructorToken   expect: [200, 204]
### note: Status travels as a QUERY parameter here, so the name 'Confirmed' is correct, while the optional body only carries a reason.

PATCH /api/v1/Bookings/{{bookingId}}/status?status=Confirmed
Accept: application/json
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "reason": null
}

################################################################################################
### [131] S205  Mark the session completed
### phase: P13   auth: instructorToken   expect: [200, 204]
### note: Needed before S206, since a session review normally requires a completed session.

PATCH /api/v1/Sessions/{{sessionId}}/status
Accept: application/json
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "status": 3
}

################################################################################################
### [132] S206  Student reviews the attended session
### phase: P13   auth: userToken   expect: [200, 204]
### note: Field is 'stars'. The instructor reviewing themselves (instructorToken) should be rejected - try it as a negative check.

POST /api/v1/sessions/{{sessionId}}/reviews
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "stars": 5,
  "comment": "Great workshop."
}

################################################################################################
### [133] S207  Cancel the booking
### phase: P13   auth: userToken   expect: [200, 204, 409]
### note: Run after S206. Once a session is Completed the cancellation window usually closes, so a 409 here is a valid result - check the reason in the response.

POST /api/v1/Bookings/{{bookingId}}/cancel
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "reason": "Schedule conflict"
}

################################################################################################
### [134] S220  Start a conversation with the other user
### phase: P14   auth: userToken   expect: [200]
### note: The other party is the account promoted to Instructor in S052, which also makes them the counterparty for S148.

POST /api/v1/Chat/conversations
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "otherUserId": "{{student2UserId}}"
}

> {% client.global.set("conversationId", pm.response.json().data.id); %}

################################################################################################
### [135] S221  List my conversations
### phase: P14   auth: userToken   expect: [200]

GET /api/v1/Chat/conversations
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
