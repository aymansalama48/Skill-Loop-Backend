// ================================================================================================
// Skill Loop Backend - Scalar Manual Test Plan
// GENERATED FILE - do not edit by hand.
// Source of truth: docs/scalar-test-plan.json   Regenerate: python docs/generate_test_artifacts.py
//
// HOW TO RUN - no Docker and no Redis required
//
//   1. Start the API. This one script resolves the security secrets, points
//      at the SQL Server instance that is actually installed, and switches
//      Redis off in favour of the in-memory cache:
//          powershell -ExecutionPolicy Bypass -File docs\run-api-local.ps1
//      It creates the database, applies migrations and seeds the admin
//      account on first start, so there is nothing else to set up.
//      Wait for 'Now listening on: https://localhost:7271'.
//
//   2. Install the VS Code extension 'REST Client' (humao.rest-client),
//      open this file and click 'Send Request' above any step.
//
//   3. Work down the file in order. Each step stores what it returns, so the
//      ids further down fill themselves in and you never copy one by hand.
//
//   Seeded login:  admin@skillloop.com / Password@123
//   Every other account used below is created by the plan itself.
//
//   To run the whole thing automatically instead, import
//   docs/skill-loop.postman_collection.json into Postman and use the
//   collection runner.
//
// Scalar UI (for browsing, not for running): https://localhost:7271/scalar/v1
// ================================================================================================

@baseUrl = https://localhost:7271

// ---- tokens: filled in automatically by the login steps, leave empty ----
@adminToken =
@userToken =
@user2Token =
@instructorToken =
@devAdminToken =

// ---- ids: filled in automatically by the create steps, leave empty ----
@adminRefreshToken =
@adminUserId =
@availabilityId =
@bookingId =
@categoryId =
@conversationId =
@courseId =
@courseMaterialId =
@emailLogId =
@instructorProfileId =
@instructorReviewId =
@instructorUserId =
@lessonId =
@lessonMaterialId =
@notificationId =
@permissionId =
@promoCode =
@promoCodeId =
@roleId =
@section2Id =
@sectionId =
@sessionId =
@sessionMaterialId =
@student1RefreshToken =
@student1UserId =
@student2UserId =
@supportQuestionId =
@testFilePath =
@userSupportQuestionId =

// ---- values you MUST fill in yourself (they arrive by email, not from the API) ----
@adminEmail =
@adminPassword =
@invitationToken =
@student1Email =
@student1Otp =
@student1Password =
@student2Email =
@student2Otp =

################################################################################################
### [  1] S001  OpenAPI document is generated
### phase: P0   auth: none   expect: [200]
### note: Open this URL directly in the browser first. If it 404s the environment is not Development, so Scalar is not mapped.

GET /openapi/v1.json
Accept: application/json


################################################################################################
### [  2] S002  Scalar UI is reachable
### phase: P0   auth: none   expect: [200]
### note: The spec URL inside Scalar must point at /openapi/v1.json. Continue the whole plan from this page.

GET /scalar/v1
Accept: application/json


################################################################################################
### [  3] S003  Bearer security scheme is present in the spec
### phase: P0   auth: none   expect: [200]
### note: Added by BearerSecuritySchemeTransformer in OpenApiExtensions.cs. This is what makes Scalar show an Auth dropdown and carry the token into every Test Request, so you never type an Authorization header by hand. If securitySchemes is missing, that transformer is not registered.

GET /openapi/v1.json
Accept: application/json


################################################################################################
### [  4] S004  Correlation id middleware echoes a trace header
### phase: P0   auth: none   expect: [200]
### note: Any header sent here comes back in problem-details responses as correlationId for steps later on.

GET /api/v1/SiteSettings
Accept: application/json
X-Correlation-Id: test-trace-0001


################################################################################################
### [  5] S010  List site settings (anonymous)
### phase: P1   auth: none   expect: [200]

GET /api/v1/SiteSettings
Accept: application/json


################################################################################################
### [  6] S011  List course categories (anonymous)
### phase: P1   auth: none   expect: [200]

GET /api/v1/Categories
Accept: application/json


################################################################################################
### [  7] S012  List published courses, page 1
### phase: P1   auth: none   expect: [200]

GET /api/v1/Courses?pageNumber=1&pageSize=10
Accept: application/json


################################################################################################
### [  8] S013  Filter courses by search, level and sort
### phase: P1   auth: none   expect: [200]
### note: Query-string enums accept names, unlike JSON bodies.

GET /api/v1/Courses?pageNumber=1&pageSize=5&searchTerm=C%23&level=Beginner&maxCredits=100&minRating=3.5&sortBy=HighestRated
Accept: application/json


################################################################################################
### [  9] S014  Get a single course by id
### phase: P1   auth: none   expect: [200, 404]
### note: Sits before S100, so courseId is still empty. Either skip this step on the first pass and rely on S107, or copy a published course id out of the S012 response and paste it into the path now. This is a deliberate early smoke check of the read path.
### MANUAL INPUT REQUIRED: fill courseId before running

GET /api/v1/Courses/{{courseId}}
Accept: application/json


################################################################################################
### [ 10] S015  List instructor profiles (anonymous)
### phase: P1   auth: none   expect: [200]

GET /api/v1/instructor-profiles?pageNumber=1&pageSize=10&minRating=0&hasCompletedSessions=True
Accept: application/json


################################################################################################
### [ 11] S016  List published FAQ questions (anonymous)
### phase: P1   auth: none   expect: [200]
### note: Note this prefix is /api/support, not /api/v1/support.

GET /api/support/questions?pageNumber=1&pageSize=10
Accept: application/json


################################################################################################
### [ 12] S017  Search and filter the public FAQ
### phase: P1   auth: none   expect: [200]

GET /api/support/questions?pageNumber=1&pageSize=10&searchTerm=password&category=General
Accept: application/json


################################################################################################
### [ 13] S018  List course reviews (anonymous)
### phase: P1   auth: none   expect: [200, 404]
### note: Early smoke check that runs before S100. S115 is the authoritative review read, executed after the reviews exist. Safe to skip here.
### MANUAL INPUT REQUIRED: fill courseId before running

GET /api/v1/courses/{{courseId}}/reviews?pageNumber=1&pageSize=10
Accept: application/json


################################################################################################
### [ 14] S019  Validate a promo code (anonymous)
### phase: P1   auth: none   expect: [200]
### note: promoCode defaults to WELCOME10, which does not exist yet. A not-found or invalid result is the correct outcome at this point. S185 is the authoritative validation, run after S183 creates the code.
### MANUAL INPUT REQUIRED: fill promoCode before running

GET /api/v1/promo-codes/{{promoCode}}/validate
Accept: application/json


################################################################################################
### [ 15] S020  Dev quick login - bootstrap the admin identity
### phase: P1   auth: none   expect: [200]
### note: Development only; returns 404 otherwise. This token has NO permissions, so it will 403 on every [Permission]-gated command. Use it only for identity checks, and switch to S021 before touching admin endpoints.

POST /api/v1/dev/quick-login
Accept: application/json


> {% client.global.set("adminUserId", pm.response.json().data.userId); %}
> {% client.global.set("devAdminToken", pm.response.json().data.accessToken); %}

################################################################################################
### [ 16] S020b  Dev user list - confirm the seeded accounts
### phase: P1   auth: none   expect: [200]
### note: Development only. Convenient for recovering the admin userId if S020 failed, but note it does not expose password hashes or refresh tokens.

GET /api/v1/dev/users
Accept: application/json


################################################################################################
### [ 17] S021  Staff login as SuperAdmin - the real admin token
### phase: P2   auth: none   expect: [200]
### note: StaffAuthService embeds the resolved permission list, unlike the dev quick login. Use this token for all admin steps.

POST /api/v1/Auth/staff/login
Accept: application/json
Content-Type: application/json

{
  "email": "admin@skillloop.com",
  "password": "Password@123"
}

> {% client.global.set("adminToken", pm.response.json().data.accessToken); %}
> {% client.global.set("adminRefreshToken", pm.response.json().data.refreshToken); %}
> {% client.global.set("adminUserId", pm.response.json().data.userId); %}

################################################################################################
### [ 18] S022  Register the primary student account
### phase: P2   auth: none   expect: [200]
### note: Email must be unique. Change the address if re-running. The account gets the 'User' role and EmailConfirmed = false.

POST /api/v1/Auth/user/register
Accept: application/json
Content-Type: application/json

{
  "firstName": "Student",
  "lastName": "One",
  "email": "student1@test.com",
  "password": "Password@123"
}

################################################################################################
### [ 19] S023  Resend the verification OTP
### phase: P2   auth: none   expect: [200]
### note: Use this if the S022 email never arrived. Only one of S022/S023 needs to run first.

POST /api/v1/auth/otp/resend
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com"
}

################################################################################################
### [ 20] S024  Verify the student email with the OTP
### phase: P2   auth: none   expect: [200]
### note: MANDATORY before S026. Read the real 6-digit code from the inbox (or the Logs folder) and replace 123456. OTP expires in 5 minutes and is limited to 3 attempts.

POST /api/v1/auth/otp/verify
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "otpCode": "123456"
}

################################################################################################
### [ 21] S025  Negative check - login before email confirmation
### phase: P2   auth: none   expect: [400]
### note: Run this ONLY if you skipped S024. Expected to fail deliberately, proving the confirmation gate works.

POST /api/v1/Auth/user/login
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "password": "Password@123"
}

################################################################################################
### [ 22] S026  Student login - primary user token
### phase: P2   auth: none   expect: [200]
### note: Enough for every [AuthenticatedOnly] student endpoint, which is most of them.

POST /api/v1/Auth/user/login
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "password": "Password@123"
}

> {% client.global.set("userToken", pm.response.json().data.accessToken); %}
> {% client.global.set("student1UserId", pm.response.json().data.userId); %}
> {% client.global.set("student1RefreshToken", pm.response.json().data.refreshToken); %}

################################################################################################
### [ 23] S027  Register the second student account
### phase: P2   auth: none   expect: [200]

POST /api/v1/Auth/user/register
Accept: application/json
Content-Type: application/json

{
  "firstName": "Student",
  "lastName": "Two",
  "email": "student2@test.com",
  "password": "Password@123"
}

################################################################################################
### [ 24] S028  Verify the second student email
### phase: P2   auth: none   expect: [200]
### note: Replace 123456 with the actual code for student2@test.com.

POST /api/v1/auth/otp/verify
Accept: application/json
Content-Type: application/json

{
  "email": "student2@test.com",
  "otpCode": "123456"
}

################################################################################################
### [ 25] S029  Second student login - the 'other user'
### phase: P2   auth: none   expect: [200]
### note: This account is promoted to Instructor later (S052). Its id is reused as the instructor id and as the chat counterpart.

POST /api/v1/Auth/user/login
Accept: application/json
Content-Type: application/json

{
  "email": "student2@test.com",
  "password": "Password@123"
}

> {% client.global.set("user2Token", pm.response.json().data.accessToken); %}
> {% client.global.set("student2UserId", pm.response.json().data.userId); %}
> {% client.global.set("instructorUserId", pm.response.json().data.userId); %}

################################################################################################
### [ 26] S030  Google staff login (documented, requires a real IdToken)
### phase: P2   auth: none   expect: [200, 400, 401]
### note: Needs GoogleAuth:ClientId configured plus a live OIDC id_token. A 400 here is a configuration result, not a code defect. The account must already exist in the database; Google login never creates users.

POST /api/v1/Auth/staff/login/google
Accept: application/json
Content-Type: application/json

{
  "idToken": "REPLACE_WITH_GOOGLE_ID_TOKEN"
}

################################################################################################
### [ 27] S031  Google user login (documented, requires a real IdToken)
### phase: P2   auth: none   expect: [200, 400, 401]
### note: Rejects staff roles on purpose, and requires EmailConfirmed = true.

POST /api/v1/Auth/user/login/google
Accept: application/json
Content-Type: application/json

{
  "idToken": "REPLACE_WITH_GOOGLE_ID_TOKEN"
}

################################################################################################
### [ 28] S032  Refresh the admin access token
### phase: P2   auth: none   expect: [200]
### note: This is the only refresh path that embeds permissions, so it upgrades any token that started empty. Refresh tokens are opaque, last 7 days, and single-use.

POST /api/v1/Auth/refresh-token
Accept: application/json
Content-Type: application/json

{
  "refreshToken": "{{adminRefreshToken}}"
}

> {% client.global.set("adminToken", pm.response.json().data.accessToken); %}
> {% client.global.set("adminRefreshToken", pm.response.json().data.refreshToken); %}

################################################################################################
### [ 29] S033  Refresh the student access token
### phase: P2   auth: none   expect: [200]
### note: Run this if a later student step returns 403 instead of 200.

POST /api/v1/Auth/refresh-token
Accept: application/json
Content-Type: application/json

{
  "refreshToken": "{{student1RefreshToken}}"
}

> {% client.global.set("userToken", pm.response.json().data.accessToken); %}
> {% client.global.set("student1RefreshToken", pm.response.json().data.refreshToken); %}

################################################################################################
### [ 30] S034  Refresh token rotation is single-use (negative check)
### phase: P2   auth: none   expect: [400, 401]
### note: Deliberate failure. Proves replay protection on the rotation path.

POST /api/v1/Auth/refresh-token
Accept: application/json
Content-Type: application/json

{
  "refreshToken": "REPLAY_THE_PREVIOUS_REFRESH_TOKEN"
}

################################################################################################
### [ 31] S035  Logout the student session
### phase: P2   auth: userToken   expect: [200, 204]
### note: The only auth endpoint requiring [Authorize]. Re-login (S026) before any later step that needs userToken.

POST /api/v1/Auth/logout
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "refreshToken": "{{student1RefreshToken}}"
}

################################################################################################
### [ 32] S040  Request a password reset OTP
### phase: P3   auth: none   expect: [200, 204]

POST /api/v1/auth/password/forgot
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com"
}

################################################################################################
### [ 33] S041  Reset the password with the OTP
### phase: P3   auth: none   expect: [200, 204]
### note: Replace 654321 with the code from S040. Afterwards student1 logs in with NewPassword@123, so re-run S026 or update later bodies.

POST /api/v1/auth/password/reset
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "otpCode": "654321",
  "newPassword": "NewPassword@123",
  "confirmPassword": "NewPassword@123"
}

################################################################################################
### [ 34] S042  Reset password mismatch is rejected (negative check)
### phase: P3   auth: none   expect: [400]
### note: Deliberate failure, confirms confirm-password is enforced.

POST /api/v1/auth/password/reset
Accept: application/json
Content-Type: application/json

{
  "email": "student1@test.com",
  "otpCode": "654321",
  "newPassword": "NewPassword@123",
  "confirmPassword": "DifferentPassword@123"
}

################################################################################################
### [ 35] S050  List all users as admin
### phase: P4   auth: adminToken   expect: [200]
### note: Controller-level [Authorize(Roles = 'Admin,SuperAdmin')]. Locate student1 and student2 here if you lost their ids.

GET /api/v1/Users?pageNumber=1&pageSize=20
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 36] S051  Filter users by role and search term
### phase: P4   auth: adminToken   expect: [200]

GET /api/v1/Users?pageNumber=1&pageSize=20&role=User&searchTerm=student
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 37] S052  Promote the second student to Instructor
### phase: P4   auth: adminToken   expect: [200, 204]
### note: Valid role names: SuperAdmin, Admin, FinanceManager, Support, User, Instructor. Do this before S141 so the account can own a profile and sessions.

POST /api/v1/Users/{{student2UserId}}/roles
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roleName": "Instructor"
}

################################################################################################
### [ 38] S053  Re-login as the promoted instructor
### phase: P4   auth: none   expect: [200]
### note: Roles are baked into the JWT, so a fresh login is mandatory after S052.

POST /api/v1/Auth/user/login
Accept: application/json
Content-Type: application/json

{
  "email": "student2@test.com",
  "password": "Password@123"
}

> {% client.global.set("instructorToken", pm.response.json().data.accessToken); %}

################################################################################################
### [ 39] S054  Remove the Instructor role again (negative/rollback check)
### phase: P4   auth: adminToken   expect: [200, 204]
### note: This undoes S052. To continue with the instructor steps, re-run S052 and S053, or skip this step entirely.

DELETE /api/v1/Users/{{student2UserId}}/roles/Instructor
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 40] S055  Deactivate a user
### phase: P4   auth: adminToken   expect: [200, 204]
### note: Deactivating the instructor invalidates instructorToken for the rest of the run. Run this near the end (see S180) or re-activate immediately after.

PATCH /api/v1/Users/{{student2UserId}}/deactivate
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 41] S056  Reactivate the user
### phase: P4   auth: adminToken   expect: [200, 204]
### note: Pair with S055 to verify the activate/deactivate round trip.

PATCH /api/v1/Users/{{student2UserId}}/activate
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 42] S060  List every permission
### phase: P4   auth: adminToken   expect: [200]
### note: Source the permissionId used in S063/S064 from this response.

GET /api/v1/PermissionManagement/permissions
Accept: application/json
Authorization: Bearer {{adminToken}}


> {% client.global.set("permissionId", pm.response.text()["first data[].id"]); %}

################################################################################################
### [ 43] S061  List roles with their permissions
### phase: P4   auth: adminToken   expect: [200]
### note: Prefer a non-critical role such as Support so admin access is not lost.

GET /api/v1/PermissionManagement/roles
Accept: application/json
Authorization: Bearer {{adminToken}}


> {% client.global.set("roleId", pm.response.text()["id of the role you intend to modify"]); %}

################################################################################################
### [ 44] S062  Permissions of one role
### phase: P4   auth: adminToken   expect: [200]

GET /api/v1/PermissionManagement/roles/{{roleId}}
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 45] S063  Assign one permission to a role
### phase: P4   auth: adminToken   expect: [200, 204]
### note: Idempotent by design; re-assigning the same pair should still succeed.

POST /api/v1/PermissionManagement/roles/{{roleId}}/permissions/{{permissionId}}/assign
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 46] S064  Remove that permission from the role
### phase: P4   auth: adminToken   expect: [200, 204]
### note: Pairs with S063 as a round trip.

POST /api/v1/PermissionManagement/roles/{{roleId}}/permissions/{{permissionId}}/remove
Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [ 47] S065  Bulk replace a role's permissions
### phase: P4   auth: adminToken   expect: [200, 204]
### note: The body is a BARE JSON ARRAY of permission id strings, not an object. Take the full current list from S062 first, or you will strip the role down to one permission.

POST /api/v1/PermissionManagement/roles/{{roleId}}/permissions/update
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

[
  "{{permissionId}}"
]

################################################################################################
### [ 48] S070  Invite a new staff member
### phase: P5   auth: adminToken   expect: [200, 204]

POST /api/v1/StaffInvitations/send
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "newstaff@test.com",
  "role": "Support"
}

################################################################################################
### [ 49] S071  Validate an invitation token
### phase: P5   auth: none   expect: [200]
### note: Take invitationToken from the S070 response body or the invitation link in the email. This endpoint is anonymous by design, which makes it the way to confirm a token is genuinely valid.
### MANUAL INPUT REQUIRED: fill invitationToken before running

GET /api/v1/StaffInvitations/validate/{{invitationToken}}
Accept: application/json


################################################################################################
### [ 50] S072  Accept the invitation with a password
### phase: P5   auth: none   expect: [200]
### note: SKIP THIS STEP on the first pass if you intend to run S073, because invitations are single-use and S072 consumes the token. Either accept with a password here (and skip S073) or accept with Google (and skip this).
### MANUAL INPUT REQUIRED: fill invitationToken before running

POST /api/v1/StaffInvitations/accept
Accept: application/json
Content-Type: application/json

{
  "invitationToken": "{{invitationToken}}",
  "fullName": "New Staff",
  "password": "Password@123",
  "phoneNumber": "01000000000"
}

################################################################################################
### [ 51] S073  Accept an invitation using Google (documented)
### phase: P5   auth: none   expect: [200, 400, 401]
### note: Mutually exclusive with S072: an invitation is single-use, so pick one accept path. Send a new invitation via S070 using the Google account's email address first.
### MANUAL INPUT REQUIRED: fill invitationToken before running
### SKIP if you already ran S072

POST /api/v1/StaffInvitations/accept-google
Accept: application/json
Content-Type: application/json

{
  "invitationToken": "{{invitationToken}}",
  "googleIdToken": "REPLACE_WITH_GOOGLE_ID_TOKEN"
}

################################################################################################
### [ 52] S080  Read my profile
### phase: P6   auth: userToken   expect: [200]
### note: The real route is /api/v1/Profile, not /api/v1/me as the README claims.

GET /api/v1/Profile
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
### [ 53] S081  Update my profile
### phase: P6   auth: userToken   expect: [200, 204]

PUT /api/v1/Profile
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "firstName": "Student",
  "lastName": "One-Updated",
  "phoneNumber": "01111111111"
}

################################################################################################
### [ 54] S082  Upload a profile picture
### phase: P6   auth: userToken   expect: [200, 204]
### note: In Scalar pick the file from disk for the 'file' field. Allowed extensions come from FileStorage options, max 10 MB. The served file is publicly reachable at /uploads/... with no auth.

PATCH /api/v1/Profile/picture
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data

// Attach a real file to the fields noted below in the REST Client panel.
// file field: file
file = C:/path/to/avatar.png

################################################################################################
### [ 55] S083  Change my password
### phase: P6   auth: userToken   expect: [200, 204]
### note: Field name is confirmNewPassword, not confirmPassword. Run this LAST in the profile phase because it invalidates the current password for later logins.

POST /api/v1/Profile/change-password
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "currentPassword": "Password@123",
  "newPassword": "ChangedPassword@123",
  "confirmNewPassword": "ChangedPassword@123"
}

################################################################################################
### [ 56] S084  Current password wrong is rejected (negative check)
### phase: P6   auth: userToken   expect: [400]
### note: Deliberate failure, proves the current password is actually checked.

POST /api/v1/Profile/change-password
Accept: application/json
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "currentPassword": "DefinitelyWrong@123",
  "newPassword": "AnotherOne@123",
  "confirmNewPassword": "AnotherOne@123"
}

################################################################################################
### [ 57] S090  Create a course category
### phase: P7   auth: adminToken   expect: [200]
### note: This is multipart/form-data, not JSON. Add the scalar fields in Scalar, optionally attaching iconFile. S100 needs this categoryId.

POST /api/v1/Categories
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data

// Attach a real file to the fields noted below in the REST Client panel.
// file field: name
name = Programming
// file field: slug
slug = programming
// file field: description
description = Software development courses
// file field: displayOrder
displayOrder = 1
// file field: iconFile
iconFile = C:/path/to/icon.png

> {% client.global.set("categoryId", pm.response.json().data.id); %}

################################################################################################
### [ 58] S091  Update the category
### phase: P7   auth: adminToken   expect: [200, 204]

PUT /api/v1/Categories/{{categoryId}}
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data

// Attach a real file to the fields noted below in the REST Client panel.
// file field: name
name = Programming & Software
// file field: slug
slug = programming-software
// file field: description
