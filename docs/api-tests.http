POST /api/v1/Chat/conversations/{{conversationId}}/messages
Accept: application/json
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "content": "Friday works for me."
}

################################################################################################
### [139] S225  Mark the conversation as read
### phase: P14   auth: userToken   expect: [200, 204]

POST /api/v1/Chat/conversations/{{conversationId}}/read
Accept: application/json
Authorization: Bearer {{userToken}}


################################################################################################
### [140] S226  Accessing someone else's conversation is denied (negative check)
### phase: P14   auth: instructorToken   expect: [200, 403, 404]
### note: This counterparty IS a participant, so 200 is correct. Use a third, unrelated account to prove the isolation.

GET /api/v1/Chat/conversations/{{conversationId}}/messages?pageNumber=1&pageSize=20
Accept: application/json
Authorization: Bearer {{instructorToken}}


