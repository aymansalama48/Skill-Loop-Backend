################################################################################################
### [103] S160  Create a session
### phase: P11   auth: instructorToken   expect: [200]
### note: locationType is the INTEGER 1 (Online) or 2 (Offline). scheduledAtUtc must be in the future and is interpreted as UTC; a past date is rejected. Use a date well ahead of the test run.

POST /api/v1/Sessions
Accept: application/json
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "title": "Advanced C# Live Workshop",
  "description": "Three hours on source generators and performance.",
  "scheduledAtUtc": "2026-12-01T18:00:00Z",
  "durationMinutes": 180,
  "creditsPrice": 20,
  "locationType": 1,
  "locationDetails": "https://meet.example.com/abc",
  "maxParticipants": 10
}

> {% client.global.set("sessionId", pm.response.json().data.id); %}

