Accept: application/json
Authorization: Bearer {{adminToken}}


################################################################################################
### [150] S245  Create an FAQ entry
### phase: P15   auth: adminToken   expect: [200]
### note: Created unpublished so it does not pollute the public FAQ check in S016 until S248 publishes it.

POST /api/support/manage/questions
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "question": "How do I reset my password?",
  "answer": "Use the forgot-password link on the login screen.",
  "category": "Account",
  "isPublished": false
}

> {% client.global.set("supportQuestionId", pm.response.json().data.id); %}

################################################################################################
### [151] S246  Answer the user's contact request
### phase: P15   auth: adminToken   expect: [200, 204]
### note: Re-run S243 afterwards to confirm it dropped off.

POST /api/support/manage/questions/{{userSupportQuestionId}}/answer
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "answer": "Check your spam folder; the OTP expires after 5 minutes.",
  "publish": false
}

################################################################################################
### [152] S247  Edit the FAQ entry
### phase: P15   auth: adminToken   expect: [200, 204]
### note: UpdateSupportQuestionRequest requires isPublished explicitly, unlike create.

PUT /api/support/manage/questions/{{supportQuestionId}}
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "question": "How do I reset my password?",
  "answer": "Choose 'Forgot password' on the login screen and enter your email. The code is valid for 5 minutes.",
  "category": "Account",
  "isPublished": false
}

################################################################################################
### [153] S248  Publish the FAQ entry
### phase: P15   auth: adminToken   expect: [200, 204]

PATCH /api/support/manage/questions/{{supportQuestionId}}/publication
Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isPublished": true
}

################################################################################################
### [154] S249  The published FAQ now appears publicly
### phase: P15   auth: none   expect: [200]

GET /api/support/questions?pageNumber=1&pageSize=20&category=Account
Accept: application/json


