# ===================================================
# Skill Loop — Docker Compose Environment Variables
# ===================================================
# Copy this file to .env and fill in the values.
# The .env file is gitignored and MUST NOT be committed.
#
#   cp .env.example .env
#
# ===================================================

# SQL Server SA password (min 8 chars, must include uppercase, lowercase, digit, symbol)
SQL_SA_PASSWORD=

# JWT signing key — generate with: openssl rand -base64 48
# Must be at least 32 bytes. Used to sign and verify all access tokens.
JWT_KEY=

# OTP HMAC hashing secret — generate with: openssl rand -base64 48
# Used to derive per-purpose HMAC keys for OTP codes. Rotating it invalidates all outstanding OTPs.
OTP_SECRET=

# SMTP password or app-password for email delivery
MAIL_PASSWORD=

# Google OAuth Client ID (public identifier, safe to share)
GOOGLE_CLIENT_ID=

# Google Drive root folder ID (only needed if FileStorage:Provider = "GoogleDrive")
DRIVE_ROOT_FOLDER_ID=

# (Optional) SuperAdmin seed credentials — set these to bootstrap the first admin user
# SEED_SUPERADMIN_EMAIL=admin@example.com
# SEED_SUPERADMIN_PASSWORD=
